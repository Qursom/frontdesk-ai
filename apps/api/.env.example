# ---------- Server ----------
PORT=4000
# Origins allowed to call the API (the Next.js app that hosts the widget + admin). Comma-separated.
CORS_ORIGINS=http://localhost:3000

# ---------- Database (MongoDB Atlas, free M0 is fine) ----------
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/frontdesk?retryWrites=true&w=majority
VECTOR_INDEX_NAME=chunks_vector_index

# ---------- AI (Google Gemini - free tier for the demo) ----------
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-gemini-key-here
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Must match numDimensions in the Atlas vector index
EMBEDDING_DIMENSIONS=768

# ---------- Admin ----------
# Long random string. Used in the x-admin-key header for /v1/admin/* and the /admin page.
ADMIN_KEY=change-me-to-a-long-random-string

# Fallback recipient for lead and handoff alert emails when a tenant's handoffEmail field is empty.
# In production each tenant sets their own handoffEmail via seed/admin. This is the safety net for demos.
HANDOFF_EMAIL=

# ---------- GDPR retention (days) ----------
CHAT_RETENTION_DAYS=30
LEAD_RETENTION_DAYS=90

# ---------- Email alerts (optional - leave SMTP_HOST empty to only log) ----------
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 and an App Password (copy without spaces: 'abcdabcdabcdabcd')
# IMPORTANT: SMTP_FROM must use the authenticated Gmail address — Gmail rejects mail from other domains.
# IMPORTANT: Strip spaces from the App Password — 'xxxx xxxx xxxx xxxx' must be 'xxxxxxxxxxxxxxxx'.
# Brevo free (300/day): SMTP_HOST=smtp-relay.brevo.com SMTP_PORT=587 SMTP_USER=<login> SMTP_PASS=<smtp-key>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="YourClinic AI <your-smtp-user@gmail.com>"

# ---------- Webhook alerts (optional - fires alongside email, zero npm deps) ----------
# POST to this URL on every lead/handoff event. Leave empty to disable.
# Payload: { "text": "<subject>\n\n<body>" }
# Compatible with: Slack incoming webhooks, Discord webhooks, ntfy.sh, Make.com HTTP triggers.
# ntfy.sh example (no account needed): https://ntfy.sh/your-secret-topic-name
NOTIFICATION_WEBHOOK_URL=

# ---------- Eval script ----------
API_URL=http://localhost:4000
