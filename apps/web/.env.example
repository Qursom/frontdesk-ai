# Public URL of the NestJS API (Render URL in production)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Server-only: powers live KPIs on /demo/dashboard. Must match ADMIN_KEY in apps/api/.env.
# Leave empty to show static demo data instead.
DASHBOARD_ADMIN_KEY=
# Tenant slug whose data the dashboard shows (defaults to bright-smile if unset)
DASHBOARD_TENANT=bright-smile
